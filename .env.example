# ─── LLM Provider ─────────────────────────────────────────
# One of: nvidia | openrouter | openai | ollama
LLM_PROVIDER=nvidia

# NVIDIA NIM (https://build.nvidia.com)
NVIDIA_API_KEY=
NVIDIA_MODEL=meta/llama-3.1-8b-instruct
NVIDIA_MODEL_ACCOUNTING=meta/llama-3.1-8b-instruct
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1

# OpenRouter (https://openrouter.ai)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free
OPENROUTER_MODEL_ACCOUNTING=meta-llama/llama-3.3-70b-instruct:free
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# OpenAI (optional fallback provider)
OPENAI_API_KEY=

# ─── Embeddings (local, via Ollama) ───────────────────────
# Requires: ollama pull nomic-embed-text
OLLAMA_BASE_URL=http://localhost:11434
EMBEDDING_MODEL=nomic-embed-text
HUGGINGFACE_MODEL=all-MiniLM-L6-v2

# ─── Chunking / Vector store ──────────────────────────────
CHUNK_SIZE=2000
CHUNK_OVERLAP=200
CHROMA_PERSIST_DIRECTORY=./chroma_db

# ─── Supabase (REQUIRED — app fails to import without these) ─
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ─── AWS S3 document storage (optional; disabled if bucket unset) ─
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=eu-north-1
S3_BUCKET_NAME=
S3_BASE_URL=

# ─── Email / SMTP (optional; demo notifications) ──────────
# Gmail: enable 2FA, then create an App Password at myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
ADMIN_EMAIL=

# ─── Server ───────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000
LOG_LEVEL=INFO
BACKEND_BASE_URL=http://localhost:8000
FRONTEND_BASE_URL=http://localhost:3000
