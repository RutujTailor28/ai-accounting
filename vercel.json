{
    "devCommand": "python main.py",
    "installCommand": "pip install -r requirements.txt",
    "builds": [
        {
            "src": "api/index.py",
            "use": "@vercel/python"
        }
    ],
    "rewrites": [
        {
            "source": "/(.*)",
            "destination": "api/index.py"
        }
    ]
}